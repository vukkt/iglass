# Builds one Warp theme file (YAML) for an iglass appearance.
#
# Inputs:
#   $palette  palette data (data/palette.json), passed with --slurpfile
#   $o        options, passed with --argjson: {accent, contrast, version}
#   $mode     "dark" | "light"
#
# Colors come from the same contrast-checked palette as the iTerm2 profiles. Warp themes carry
# only colors: the glass (window opacity and blur) is a Warp setting, which iglass writes to
# settings.toml. The accent colors Warp's own interface (tabs, the selected block, buttons);
# "details" tells Warp whether to draw its interface for a dark or a light background.

$palette[0] as $p |
(if $o.contrast == "high" then $p.highContrast else $p end) as $colors |
($colors.modes[$mode] + $colors.accents[$o.accent][$mode]) as $c |

def hex2: round | [(. / 16 | floor), (. % 16)] | map("0123456789abcdef"[.:. + 1]) | add;
def hex: "'#" + ([."Red Component", ."Green Component", ."Blue Component"] | map(. * 255 | hex2) | add) + "'";
def ansi($i): $c["Ansi \($i) Color"] | hex;
def group($from): [
  "    black: \(ansi($from))", "    red: \(ansi($from + 1))", "    green: \(ansi($from + 2))",
  "    yellow: \(ansi($from + 3))", "    blue: \(ansi($from + 4))", "    magenta: \(ansi($from + 5))",
  "    cyan: \(ansi($from + 6))", "    white: \(ansi($from + 7))"
];

([
  "# iglass (\($mode)) for Warp",
  "# Generated by iglass \($o.version) (https://github.com/vukkt/iglass). `iglass install` rewrites this file.",
  "name: iglass \(if $mode == "dark" then "Dark" else "Light" end)",
  "accent: \($c["Tab Color"] | hex)",
  "cursor: \($c["Cursor Color"] | hex)",
  "background: \($c["Background Color"] | hex)",
  "foreground: \($c["Foreground Color"] | hex)",
  "details: \(if $mode == "dark" then "darker" else "lighter" end)",
  "terminal_colors:",
  "  normal:"
] + group(0) + ["  bright:"] + group(8)
) | join("\n") + "\n"
