# Builds one Ghostty theme file (a Ghostty config fragment) for an iglass variant and appearance.
#
# Inputs:
#   $palette  palette data (data/palette.json), passed with --slurpfile
#   $o        options, passed with --argjson:
#               {accent, contrast, glass: "native"|"blur", variant, custom, version}
#               custom: null | {base, overrides: {transparency?, blur?, blurRadius?}}
#   $mode     "dark" | "light"
#   $which    a variant name, or "custom"
#
# Colors come from the same contrast-checked palette as the iTerm2 profiles. Ghostty theme files
# may set any option, so each one also carries its variant's opacity and blur: real Liquid Glass
# (macos-glass-regular / macos-glass-clear) where Ghostty and macOS support it, a classic blur
# radius otherwise.

$palette[0] as $p |
(if $o.contrast == "high" then $p.highContrast else $p end) as $colors |
($colors.modes[$mode] + $colors.accents[$o.accent][$mode]) as $c |

def hex2: round | [(. / 16 | floor), (. % 16)] | map("0123456789abcdef"[.:. + 1]) | add;
def hex: "#" + ([."Red Component", ."Green Component", ."Blue Component"] | map(. * 255 | hex2) | add);

(if $which == "custom" then $p.variants[$o.custom.base] + $o.custom.overrides
 else $p.variants[$which] end) as $v |
(if $which == "custom" then $o.custom.base else $which end) as $base |
($which == "custom" and ($o.custom.overrides | has("blurRadius"))) as $explicit_radius |

def blur_value:
  if ($v.blur | not) or $v.blurRadius == 0 then "false"
  elif $o.glass == "native" and ($explicit_radius | not) then
    (if $base == "clear" then "macos-glass-clear" else "macos-glass-regular" end)
  else ($v.blurRadius | tostring) end;

def opacity: ((1 - $v.transparency) * 100 | round) / 100;

([
  "# iglass \(if $which == "custom" then "Custom" else ($which[0:1] | ascii_upcase) + $which[1:] end) (\($mode)) for Ghostty",
  "# Generated by iglass \($o.version) (https://github.com/vukkt/iglass). `iglass install` rewrites this file.",
  "background = \($c["Background Color"] | hex)",
  "foreground = \($c["Foreground Color"] | hex)",
  "cursor-color = \($c["Cursor Color"] | hex)",
  "cursor-text = \($c["Cursor Text Color"] | hex)",
  "selection-background = \($c["Selection Color"] | hex)",
  "selection-foreground = \($c["Selected Text Color"] | hex)"
]
+ [range(0; 16) as $i | "palette = \($i)=\($c["Ansi \($i) Color"] | hex)"]
+ [
  "background-opacity = \(opacity)",
  "background-blur = \(blur_value)"
]) | join("\n") + "\n"
