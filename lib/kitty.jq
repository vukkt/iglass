# Builds one kitty colors file for an iglass appearance.
#
# Inputs:
#   $palette  palette data (data/palette.json), passed with --slurpfile
#   $o        options, passed with --argjson: {accent, contrast, window, version}
#   $mode     "dark" | "light"
#   $title    the file's first comment line
#
# Colors come from the same contrast-checked palette as the iTerm2 profiles and Ghostty themes.
# kitty resets every color a theme file leaves out, so each file sets them all. Theme files
# (the *-theme.auto.conf files kitty switches between) only carry colors; opacity and blur live
# in iglass.conf. The macOS title bar color is one of those colors: "background" makes the title
# bar part of the glass, as in native apps.

$palette[0] as $p |
(if $o.contrast == "high" then $p.highContrast else $p end) as $colors |
($colors.modes[$mode] + $colors.accents[$o.accent][$mode]) as $c |

def hex2: round | [(. / 16 | floor), (. % 16)] | map("0123456789abcdef"[.:. + 1]) | add;
def hex: "#" + ([."Red Component", ."Green Component", ."Blue Component"] | map(. * 255 | hex2) | add);

([
  "# \($title)",
  "# Generated by iglass \($o.version) (https://github.com/vukkt/iglass). `iglass install` rewrites this file.",
  "foreground \($c["Foreground Color"] | hex)",
  "background \($c["Background Color"] | hex)",
  "cursor \($c["Cursor Color"] | hex)",
  "cursor_text_color \($c["Cursor Text Color"] | hex)",
  "selection_foreground \($c["Selected Text Color"] | hex)",
  "selection_background \($c["Selection Color"] | hex)",
  "url_color \($c["Link Color"] | hex)"
]
+ [range(0; 16) as $i | "color\($i) \($c["Ansi \($i) Color"] | hex)"]
+ (if $o.window == "keep" then [] else ["macos_titlebar_color background"] end)
) | join("\n") + "\n"
