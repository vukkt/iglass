  "contrast": {
    "$comment": "Text is checked against the window background blended over desktops behind it. Tinted and Solid: pure black and pure white. Frosted: dark and light grey, standing in for typical blurred wallpapers. Clear: mid-grey only; at that translucency no palette can stay readable over every wallpaper.",
    "tiers": [
      {
        "variants": [
          "tinted",
          "solid"
        ],
        "desktops": [
          "#000000",
          "#FFFFFF"
        ]
      },
      {
        "variants": [
          "frosted"
        ],
        "desktops": [
          "#333333",
          "#CCCCCC"
        ]
      },
      {
        "variants": [
          "clear"
        ],
        "desktops": [
          "#808080"
        ]
      }
    ],
    "safeOpacityDesktops": [
      "#333333",
      "#CCCCCC"
    ],
    "targets": {
      "foreground": 7.0,
      "ansiNormal": {
        "dark": 3.0,
        "light": 4.5
      },
      "ansiBright": {
        "dark": 4.5,
        "light": 3.0
      },
      "ansiMuted": 3.0,
      "ansiNormalOnSolid": 4.5,
      "brightLightnessGap": 0.05,
      "link": 3.0,
      "linkOnSolid": 4.5,
      "cursor": 3.0,
      "selectionText": 4.5,
      "findText": 4.5
    },
    "muted": {
      "$comment": "Deliberately quiet slots (comments, autosuggestions). Checked against ansiMuted instead of the normal/bright targets.",
      "dark": [
        "brightBlack"
      ],
      "light": [
        "brightBlack"
      ]
    },
    "exempt": {
      "$comment": "Background-like ANSI slots. Programs use them for fills, not for text on the default background.",
      "dark": [
        "black"
      ],
      "light": [
        "white",
        "brightWhite"
      ]
    },
    "selectionAlpha": {
      "dark": 0.38,
      "light": 0.24
    },
    "findAlpha": {
      "dark": 0.42,
      "light": 0.5
    }
  }
