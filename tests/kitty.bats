#!/usr/bin/env bats
# shellcheck disable=SC2030,SC2031  # per-test exports are meant to stay inside each test
# kitty support: theme files kitty switches between, iglass.conf, and one include line in
# kitty.conf, in the config directory kitty itself would choose. Runs on macOS and Linux.

load helpers

setup() {
  setup_sandbox
  fake_kitty
  K="$HOME/.config/kitty"
}

include_line() { printf 'include %s/iglass.conf\n' "${1:-$K}"; }
include_count() { grep -cxF "$(include_line "${2:-$K}")" "$1" || true; }
themes="dark-theme.auto.conf light-theme.auto.conf no-preference-theme.auto.conf"

@test "kitty: installs iglass.conf, the three theme files and one include line" {
  run "$IGLASS" install --terminal kitty
  assert_success_
  assert_output_has "Installed iglass for kitty (blur, light and dark, blue accent)"
  for f in iglass.conf $themes; do
    [[ -f "$K/$f" ]]
    grep -q '^# Generated by iglass' "$K/$f"
  done
  [[ "$(include_count "$K/kitty.conf")" == 1 ]]
  run jq -r '.kitty | "\(.dir) \(.createdConfig)"' "$(state_file)"
  [[ "$output" == "$K true" ]]
  [[ ! -e "$(profile_file)" ]] # iTerm2 untouched
}

@test "kitty: an existing kitty.conf is restored byte for byte, keeping its permissions" {
  mkdir -p "$K"
  printf 'font_size 14\n# mine\nmap ctrl+t new_tab' >"$K/kitty.conf"
  chmod 600 "$K/kitty.conf"
  cp "$K/kitty.conf" "$BATS_TEST_TMPDIR/original"
  "$IGLASS" install --terminal kitty
  [[ "$(include_count "$K/kitty.conf")" == 1 ]]
  grep -qx 'map ctrl+t new_tab' "$K/kitty.conf" # not glued to iglass's lines
  [[ -n "$(find "$K/kitty.conf" -perm 600)" ]]
  "$IGLASS" install --terminal kitty --accent green
  [[ "$(include_count "$K/kitty.conf")" == 1 ]] # never duplicated
  "$IGLASS" uninstall --terminal kitty
  cmp "$K/kitty.conf" "$BATS_TEST_TMPDIR/original"
  run ls -A "$K"
  [[ "$output" == kitty.conf ]]
}

@test "kitty: uninstall removes a config iglass created, and is safe to repeat" {
  "$IGLASS" install --terminal kitty
  run "$IGLASS" uninstall --terminal kitty
  assert_success_
  assert_output_has "Removed iglass from kitty"
  [[ ! -e "$K" ]]
  run "$IGLASS" uninstall --terminal kitty
  assert_success_
  assert_output_has "iglass was not installed for kitty"
}

@test "kitty: your own light/dark theme files are set aside and come back on uninstall" {
  mkdir -p "$K"
  printf '# Dracula\nbackground #282a36\n' >"$K/dark-theme.auto.conf"
  cp "$K/dark-theme.auto.conf" "$BATS_TEST_TMPDIR/mine"
  run "$IGLASS" install --terminal kitty
  assert_output_has "Your own kitty light/dark theme files are saved"
  grep -q '^# Generated by iglass' "$K/dark-theme.auto.conf"
  "$IGLASS" install --terminal kitty --accent pink # a reinstall keeps them saved
  "$IGLASS" uninstall --terminal kitty
  cmp "$K/dark-theme.auto.conf" "$BATS_TEST_TMPDIR/mine"
  [[ ! -e "$K/light-theme.auto.conf" ]]
}

@test "kitty: a theme file made after installing is kept too, never overwritten" {
  "$IGLASS" install --terminal kitty
  printf '# made later\n' >"$K/light-theme.auto.conf"
  run "$IGLASS" doctor
  assert_output_has "light-theme.auto.conf isn't iglass's"
  run "$IGLASS" install --terminal kitty
  assert_success_
  grep -q '^# Generated by iglass' "$K/light-theme.auto.conf"
  run cat "$IGLASS_STATE_DIR/backups/kitty-themes/light-theme.auto.conf"
  [[ "$output" == "# made later" ]]
  "$IGLASS" uninstall --terminal kitty
  cmp "$K/light-theme.auto.conf" <(printf '# made later\n')
}

@test "kitty: the config directory is chosen exactly the way kitty does" {
  # Default: ~/.config/kitty, created.
  "$IGLASS" install --terminal kitty
  [[ -f "$HOME/.config/kitty/iglass.conf" ]]
  "$IGLASS" uninstall --terminal kitty

  # On macOS, ~/Library/Preferences/kitty counts when it has a kitty.conf.
  mkdir -p "$HOME/Library/Preferences/kitty"
  : >"$HOME/Library/Preferences/kitty/kitty.conf"
  "$IGLASS" install --terminal kitty
  [[ -f "$HOME/Library/Preferences/kitty/iglass.conf" ]]
  [[ "$(include_count "$HOME/Library/Preferences/kitty/kitty.conf" "$HOME/Library/Preferences/kitty")" == 1 ]]
  "$IGLASS" uninstall --terminal kitty

  # $XDG_CONFIG_HOME comes first, but only with a kitty.conf in it.
  export XDG_CONFIG_HOME="$SANDBOX/xdg-home"
  mkdir -p "$XDG_CONFIG_HOME/kitty"
  run "$IGLASS" install --terminal kitty
  [[ -f "$HOME/Library/Preferences/kitty/iglass.conf" && ! -e "$XDG_CONFIG_HOME/kitty/iglass.conf" ]]
  "$IGLASS" uninstall --terminal kitty
  : >"$XDG_CONFIG_HOME/kitty/kitty.conf"
  "$IGLASS" install --terminal kitty
  [[ -f "$XDG_CONFIG_HOME/kitty/iglass.conf" ]]
  "$IGLASS" uninstall --terminal kitty

  # A read-only directory (e.g. managed by Nix) is skipped, as kitty skips it.
  chmod 555 "$XDG_CONFIG_HOME/kitty"
  "$IGLASS" install --terminal kitty
  chmod 755 "$XDG_CONFIG_HOME/kitty"
  [[ -f "$HOME/Library/Preferences/kitty/iglass.conf" ]]
  "$IGLASS" uninstall --terminal kitty

  # KITTY_CONFIG_DIRECTORY always wins.
  export KITTY_CONFIG_DIRECTORY="$SANDBOX/kcd"
  "$IGLASS" install --terminal kitty
  [[ -f "$SANDBOX/kcd/iglass.conf" && -f "$SANDBOX/kcd/kitty.conf" ]]
}

@test "kitty: ~/Library/Preferences is a macOS location only" {
  use_linux
  fake_kitty
  mkdir -p "$HOME/Library/Preferences/kitty"
  : >"$HOME/Library/Preferences/kitty/kitty.conf"
  XDG_CURRENT_DESKTOP=KDE "$IGLASS" install --terminal kitty
  [[ -f "$HOME/.config/kitty/iglass.conf" && ! -e "$HOME/Library/Preferences/kitty/iglass.conf" ]]
}

@test "kitty: colors follow light and dark mode, or stay pinned with --appearance" {
  "$IGLASS" install --terminal kitty
  dark=$(grep '^background ' "$K/dark-theme.auto.conf")
  light=$(grep '^background ' "$K/light-theme.auto.conf")
  [[ "$dark" != "$light" ]]
  [[ "$(grep '^background ' "$K/no-preference-theme.auto.conf")" == "$light" ]] # GNOME's light mode
  "$IGLASS" install --terminal kitty --appearance dark
  for f in $themes; do [[ "$(grep '^background ' "$K/$f")" == "$dark" ]]; done
  "$IGLASS" install --terminal kitty --appearance light
  for f in $themes; do [[ "$(grep '^background ' "$K/$f")" == "$light" ]]; done
}

@test "kitty: theme files set every color, and colors match the Ghostty themes" {
  "$IGLASS" install --terminal kitty --accent orange --contrast high
  "$IGLASS" export --terminal ghostty --accent orange --contrast high --dir "$SANDBOX/g"
  for i in $(seq 0 15); do
    k=$(sed -n "s/^color$i //p" "$K/light-theme.auto.conf")
    g=$(sed -n "s/^palette = $i=//p" "$SANDBOX/g/themes/iglass-frosted-light")
    [[ -n "$k" && "$k" == "$g" ]]
  done
  for key in foreground background cursor cursor_text_color selection_foreground selection_background url_color; do
    grep -qE "^$key #[0-9a-f]{6}$" "$K/dark-theme.auto.conf"
  done
}

@test "kitty: glass levels set opacity and blur; Solid is opaque" {
  "$IGLASS" install --terminal kitty --variant clear
  grep -qx 'background_opacity 0.5' "$K/iglass.conf"
  grep -qx 'background_blur 12' "$K/iglass.conf"
  "$IGLASS" install --terminal kitty --variant tinted
  grep -qx 'background_opacity 0.82' "$K/iglass.conf"
  run "$IGLASS" install --terminal kitty --variant solid
  assert_output_has "(opaque,"
  grep -qx 'background_opacity 1' "$K/iglass.conf"
  grep -qx 'background_blur 0' "$K/iglass.conf"
  "$IGLASS" install --terminal kitty --variant clear --opacity 0.8 --blur 30
  grep -qx 'background_opacity 0.8' "$K/iglass.conf"
  grep -qx 'background_blur 30' "$K/iglass.conf"
}

@test "kitty: cursor, window and font options map to kitty settings" {
  "$IGLASS" install --terminal kitty --cursor box --window no-titlebar --font "Menlo-Regular 14"
  grep -qx 'cursor_shape block' "$K/iglass.conf"
  grep -qx 'hide_window_decorations titlebar-only' "$K/iglass.conf"
  grep -qx 'font_family Mock Family' "$K/iglass.conf"
  grep -qx 'font_size 14' "$K/iglass.conf"
  grep -qx 'macos_titlebar_color background' "$K/dark-theme.auto.conf"
  "$IGLASS" install --terminal kitty --cursor keep --window keep
  run grep -E '^(cursor_shape|hide_window_decorations|wayland_titlebar_color|macos_titlebar_color)' "$K/iglass.conf" "$K/dark-theme.auto.conf"
  [[ "$status" -eq 1 ]]
  "$IGLASS" install --terminal kitty
  grep -qx 'cursor_shape beam' "$K/iglass.conf"
  grep -qx 'wayland_titlebar_color background' "$K/iglass.conf"
}

@test "kitty: nothing changes when kitty rejects the generated files" {
  mkdir -p "$K"
  printf 'font_size 14\n' >"$K/kitty.conf"
  MOCK_KITTY_REJECT=1 run "$IGLASS" install --terminal kitty
  assert_failure_
  assert_output_has "Nothing was changed"
  assert_output_has "Ignoring unknown config key"
  run ls -A "$K"
  [[ "$output" == kitty.conf ]]
  cmp "$K/kitty.conf" <(printf 'font_size 14\n')
}

@test "kitty: a symlinked kitty.conf stays a symlink; a read-only one gets instructions" {
  mkdir -p "$K" "$SANDBOX/dotfiles"
  printf 'font_size 14\n' >"$SANDBOX/dotfiles/kitty.conf"
  ln -s "$SANDBOX/dotfiles/kitty.conf" "$K/kitty.conf"
  "$IGLASS" install --terminal kitty
  [[ -L "$K/kitty.conf" ]]
  [[ "$(include_count "$SANDBOX/dotfiles/kitty.conf")" == 1 ]]
  "$IGLASS" uninstall --terminal kitty
  cmp "$SANDBOX/dotfiles/kitty.conf" <(printf 'font_size 14\n')

  rm "$K/kitty.conf"
  printf 'font_size 14\n' >"$K/kitty.conf"
  chmod 444 "$K/kitty.conf"
  run "$IGLASS" install --terminal kitty
  assert_success_
  assert_output_has "Add these two lines"
  assert_output_has "$(include_line)"
  [[ -f "$K/iglass.conf" ]]
  chmod 644 "$K/kitty.conf"
}

# iTerm2 profiles are checked with Apple's plutil, so tests that include iTerm2 need macOS.
needs_macos_tools() { [[ "$(uname -s)" == Darwin ]] || skip "needs macOS tools (plutil)"; }

@test "kitty: must be installed; --terminal all skips it when it isn't" {
  needs_macos_tools
  export IGLASS_KITTY_BIN="$SANDBOX/missing"
  run "$IGLASS" install --terminal kitty
  assert_failure_
  assert_output_has "kitty is not installed"
  run "$IGLASS" install --terminal all
  assert_success_
  assert_output_has "kitty isn't installed; skipped"
  assert_output_has "Ghostty isn't installed; skipped"
  [[ -f "$(profile_file)" && ! -e "$K" ]]
}

@test "kitty on Linux: --terminal all installs Ghostty and skips a missing kitty" {
  use_linux
  export IGLASS_KITTY_BIN="$SANDBOX/missing"
  XDG_CURRENT_DESKTOP=KDE run "$IGLASS" install --terminal all
  assert_success_
  assert_output_has "kitty isn't installed; skipped"
  [[ -f "$IGLASS_GHOSTTY_XDG_DIR/iglass.ghostty" && ! -e "$K" ]]
  use_linux none
  run "$IGLASS" install --terminal all
  assert_failure_
  assert_output_has "None of the terminals iglass supports is installed"
}

@test "kitty: --terminal all installs every installed terminal; plain uninstall removes all" {
  needs_macos_tools
  fake_ghostty
  run "$IGLASS" install --terminal all
  assert_success_
  [[ -f "$(profile_file)" && -f "$IGLASS_GHOSTTY_XDG_DIR/iglass.ghostty" && -f "$K/iglass.conf" ]]
  run "$IGLASS" uninstall
  assert_success_
  [[ ! -e "$(profile_file)" && ! -e "$IGLASS_GHOSTTY_XDG_DIR/iglass.ghostty" && ! -e "$K" ]]
}

@test "kitty: running inside kitty installs for kitty by default" {
  KITTY_WINDOW_ID=1 TERM_PROGRAM=iTerm.app run "$IGLASS" install
  assert_success_
  assert_output_has "for kitty"
  [[ -f "$K/iglass.conf" && ! -e "$(profile_file)" ]]
}

@test "kitty: kitty before 0.38 gets a note that colors won't switch" {
  fake_kitty 0.36.4
  run "$IGLASS" install --terminal kitty
  assert_success_
  assert_output_has "kitty 0.36.4 can't switch colors with light and dark mode"
  grep -q '^# Colors for kitty before 0.38' "$K/iglass.conf"
}

@test "kitty: --glass native explains that kitty has no Liquid Glass" {
  run "$IGLASS" install --terminal kitty --glass native
  assert_success_
  assert_output_has "kitty has no Liquid Glass material"
}

@test "kitty: preview opens kitty with the variant's glass" {
  run "$IGLASS" preview --terminal kitty
  assert_failure_
  assert_output_has "not installed for kitty"
  "$IGLASS" install --terminal kitty --variant tinted
  run "$IGLASS" preview --terminal kitty
  assert_success_
  assert_logged "-o background_opacity=0.82 -o background_blur=26"
  run "$IGLASS" preview --terminal kitty --variant clear
  assert_logged "-o background_opacity=0.5 -o background_blur=12"
  run "$IGLASS" preview --terminal kitty --variant custom
  assert_failure_
  run "$IGLASS" preview --terminal kitty --variant mist
  assert_failure_
}

@test "kitty: export writes the files to a folder, and needs one" {
  run "$IGLASS" export --terminal kitty --dir "$SANDBOX/out"
  assert_success_
  for f in iglass.conf $themes; do [[ -f "$SANDBOX/out/$f" ]]; done
  [[ ! -e "$K" ]]
  run "$IGLASS" export --terminal kitty
  assert_failure_
  assert_output_has "--dir"
}

@test "kitty: status and doctor report the install, and settings that override it" {
  if [[ "$(uname -s)" != Darwin ]]; then # doctor's macOS checks need macOS tools
    use_linux
    fake_kitty
    export XDG_CURRENT_DESKTOP=KDE
  fi
  "$IGLASS" install --terminal kitty --accent green
  run "$IGLASS" status
  assert_output_has "accent green"
  assert_output_has "kitty 0.49.2"
  run "$IGLASS" doctor
  assert_success_
  assert_output_has "Colors follow light and dark mode"
  assert_output_has "Included from $K/kitty.conf"
  assert_output_has "kitty accepts your configuration"
  printf 'background_opacity 1\n' >>"$K/kitty.conf"
  run "$IGLASS" doctor
  assert_output_has "1 setting(s) after iglass's include"
  printf 'font_size 12\n' >"$K/kitty.conf"
  run "$IGLASS" doctor
  assert_failure_
  assert_output_has "doesn't include iglass"
}

@test "kitty on Linux: Tinted on desktops without blur, blur on KDE" {
  use_linux none
  fake_kitty
  unset IGLASS_STATE_DIR
  export XDG_STATE_HOME="$SANDBOX/state-home"
  XDG_CURRENT_DESKTOP=GNOME run "$IGLASS" install
  assert_success_
  assert_output_has "GNOME doesn't blur behind windows, so iglass uses Tinted"
  assert_output_has "for kitty (transparency, no blur on this desktop"
  grep -qx 'background_opacity 0.82' "$K/iglass.conf"
  XDG_CURRENT_DESKTOP=KDE run "$IGLASS" install --variant frosted
  assert_output_has "for kitty (blur,"
  run "$IGLASS" preview
  assert_logged "setsid $IGLASS_KITTY_BIN -o background_opacity=0.66"
}

@test "kitty: generated files pass the real kitty parser (skipped without kitty)" {
  local real=""
  for c in /Applications/kitty.app/Contents/MacOS/kitty "$(PATH=${PATH#"$MOCK_DIR/bin:"} command -v kitty 2>/dev/null)"; do
    [[ -n "$c" && -x "$c" ]] && { real=$c; break; }
  done
  [[ -n "$real" ]] || skip "kitty is not installed"
  export IGLASS_KITTY_BIN="$real"
  local accent contrast window appearance out
  for contrast in standard high; do
    for window in native no-titlebar keep; do
      for appearance in auto dark; do
        accent=$([[ $contrast == high ]] && echo graphite || echo pink)
        out="$SANDBOX/real-$contrast-$window-$appearance"
        "$IGLASS" export --terminal kitty --contrast "$contrast" --window "$window" --appearance "$appearance" \
          --accent "$accent" --opacity 0.8 --dir "$out"
        run "$real" +runpy 'import sys
from kitty.config import load_config
for p in sys.argv[1:]:
    load_config(p)' "$out"/*.conf
        [[ "$status" -eq 0 && -z "$output" ]] || { echo "$output" >&2; return 1; }
      done
    done
  done
  # And a real install, validated by iglass itself with the real kitty.
  run "$IGLASS" install --terminal kitty --variant clear
  assert_success_
  run "$IGLASS" doctor
  assert_output_has "kitty accepts your configuration"
}
