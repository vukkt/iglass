#!/usr/bin/env bats
# shellcheck disable=SC2030,SC2031  # per-test exports are meant to stay inside each test
# Warp support: two theme files, and iglass's settings in Warp's settings.toml, with every other
# line of the user's settings left alone and theirs put back on uninstall. Runs on macOS and Linux.

load helpers

setup() {
  setup_sandbox
  fake_warp
  S="$HOME/.warp/settings.toml"
  T="$HOME/.warp/themes"
}

# setting TABLE KEY — the line that sets KEY under [TABLE] in settings.toml.
setting() {
  awk -v t="[$1]" -v k="$2" '/^\[/ { in_t = ($0 == t) } in_t && index($0, k " = ") == 1' "$S"
}

@test "warp: writes the two themes and iglass's settings" {
  run "$IGLASS" install --terminal warp
  assert_success_
  assert_output_has "Installed iglass for Warp (blur, light and dark, blue accent). Warp applies it right away."
  for mode in dark light; do
    grep -q '^# Generated by iglass' "$T/iglass-$mode.yaml"
  done
  grep -qx 'name: iglass Dark' "$T/iglass-dark.yaml"
  grep -qx 'details: darker' "$T/iglass-dark.yaml"
  grep -qx 'details: lighter' "$T/iglass-light.yaml"
  grep -qx "accent: '#0a84ff'" "$T/iglass-dark.yaml" # quoted: a bare # starts a YAML comment
  [[ "$(grep -c "^    [a-z]*: '#[0-9a-f]\{6\}'$" "$T/iglass-light.yaml")" == 16 ]] || false
  [[ "$(setting appearance.themes theme)" == "theme = { custom = { name = \"iglass Dark\", path = \"$T/iglass-dark.yaml\" } }" ]] || false
  [[ "$(setting appearance.themes system_theme)" == "system_theme = true" ]] || false
  setting appearance.themes selected_system_themes | grep -qF "light = { custom = { name = \"iglass Light\", path = \"$T/iglass-light.yaml\" } }"
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 66" ]] || false
  [[ "$(setting appearance.window override_blur)" == "override_blur = 24" ]] || false
  [[ "$(setting appearance.cursor cursor_display_type)" == 'cursor_display_type = "bar"' ]] || false
  run jq -r '.warp | "\(.settings) \(.createdFile)"' "$(state_file)"
  [[ "$output" == "$S true" ]] || false
  [[ ! -e "$(profile_file)" ]] || false # iTerm2 untouched
}

@test "warp: your settings.toml is restored byte for byte, through reinstalls with other options" {
  mkdir -p "$HOME/.warp"
  printf '# my Warp\n[appearance.text]\nfont_size = 14.0 # big\n\n[appearance.themes]\ntheme = "dracula"\n\n[agents.profiles]\nlist = [\n  "a",\n]' >"$S"
  chmod 600 "$S"
  cp "$S" "$BATS_TEST_TMPDIR/original"
  "$IGLASS" install --terminal warp
  [[ "$(setting appearance.themes theme)" == *iglass-dark.yaml* ]] || false
  [[ "$(setting appearance.text font_size)" == "font_size = 14.0 # big" ]] || false
  grep -qx '  "a",' "$S"
  [[ -n "$(find "$S" -perm 600)" ]] || false
  "$IGLASS" install --terminal warp --variant clear --font "Menlo-Regular 15" --appearance light
  [[ "$(setting appearance.text font_size)" == "font_size = 15.0" ]] || false
  [[ "$(setting appearance.themes theme)" == *iglass-light.yaml* ]] || false
  "$IGLASS" install --terminal warp # --font keep again: your font size comes back
  [[ "$(setting appearance.text font_size)" == "font_size = 14.0 # big" ]] || false
  [[ "$(grep -c '^\[appearance.themes\]' "$S")" == 1 ]] || false # never a second copy of a table
  run "$IGLASS" uninstall --terminal warp
  assert_output_has "Removed iglass from Warp"
  cmp "$S" "$BATS_TEST_TMPDIR/original"
  [[ ! -e "$T" ]] || false
}

@test "warp: settings you changed in Warp after installing are kept on uninstall" {
  mkdir -p "$HOME/.warp"
  printf '[appearance.window]\nzoom_level = 110\n' >"$S"
  "$IGLASS" install --terminal warp
  # What Warp does when you change settings: rewrite paths relative to the themes folder, and
  # save whatever you changed on its settings page.
  sed -i.bak -e "s|$T/||g" -e 's/override_opacity = 66/override_opacity = 90/' "$S"
  run "$IGLASS" uninstall --terminal warp
  assert_success_
  assert_output_has "Kept your own Warp setting: override_opacity = 90"
  [[ "$(cat "$S")" == $'[appearance.window]\nzoom_level = 110\noverride_opacity = 90' ]] || false
}

@test "warp: a table iglass added keeps settings you add to it, and goes once empty" {
  "$IGLASS" install --terminal warp --font "Menlo-Regular 15"
  [[ "$(setting appearance.text font_name)" == 'font_name = "Mock Family"' ]] || false
  "$IGLASS" install --terminal warp # no --font: iglass's [appearance.text] goes with it
  ! grep -q 'appearance.text' "$S" || false
  sed -i.bak 's/^\[appearance.window\]$/&\
zoom_level = 110/' "$S" # Warp saved a setting into iglass's [appearance.window]
  "$IGLASS" uninstall --terminal warp
  [[ "$(cat "$S")" == $'[appearance.window]\nzoom_level = 110' ]] || false
}

@test "warp: a setting written across several lines is replaced whole" {
  mkdir -p "$HOME/.warp"
  printf '[appearance.themes]\nselected_system_themes = {\n  light = "light",\n  dark = "dracula",\n}\ntheme = "dracula"\n' >"$S"
  cp "$S" "$BATS_TEST_TMPDIR/original"
  "$IGLASS" install --terminal warp
  ! grep -q 'dracula' "$S" || false
  ! grep -qx '}' "$S" || false
  [[ "$(grep -c 'selected_system_themes' "$S")" == 1 ]] || false
  "$IGLASS" uninstall --terminal warp
  cmp "$S" "$BATS_TEST_TMPDIR/original"
}

@test "warp: a settings file iglass created is removed again, and uninstall is safe to repeat" {
  "$IGLASS" install --terminal warp
  run "$IGLASS" uninstall --terminal warp
  assert_success_
  [[ ! -e "$HOME/.warp" ]] || false
  run "$IGLASS" uninstall --terminal warp
  assert_success_
  assert_output_has "iglass was not installed for Warp"
}

@test "warp: the glass for each variant, custom settings and a pinned appearance" {
  "$IGLASS" install --terminal warp --variant clear
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 50" ]] || false
  [[ "$(setting appearance.window override_blur)" == "override_blur = 12" ]] || false
  "$IGLASS" install --terminal warp --variant tinted
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 82" ]] || false
  run "$IGLASS" install --terminal warp --variant solid
  assert_output_has "for Warp (opaque, "
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 100" ]] || false
  [[ "$(setting appearance.window override_blur)" == "override_blur = 1" ]] || false # Warp's lowest
  run "$IGLASS" install --terminal warp --opacity 0.7 --blur 40
  assert_output_has "custom opacity 0.7, custom blur 40"
  [[ "$output" != *"iTerm2 slow"* ]] || false # that warning is for iTerm2 only
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 70" ]] || false
  [[ "$(setting appearance.window override_blur)" == "override_blur = 40" ]] || false
  "$IGLASS" install --terminal warp --appearance light --cursor box --accent purple
  [[ "$(setting appearance.themes system_theme)" == "system_theme = false" ]] || false
  [[ "$(setting appearance.themes theme)" == *'"iglass Light"'* ]] || false
  [[ "$(setting appearance.cursor cursor_display_type)" == 'cursor_display_type = "block"' ]] || false
  grep -qx "accent: '#af52de'" "$T/iglass-light.yaml" # Apple's purple, in light mode
}

@test "warp: --cursor keep leaves Warp's cursor alone" {
  mkdir -p "$HOME/.warp"
  printf '[appearance.cursor]\ncursor_display_type = "underline"\n' >"$S"
  "$IGLASS" install --terminal warp --cursor keep
  [[ "$(setting appearance.cursor cursor_display_type)" == 'cursor_display_type = "underline"' ]] || false
}

@test "warp: settings written another way are never duplicated: iglass stops and explains" {
  mkdir -p "$HOME/.warp"
  printf '[appearance]\nwindow.override_opacity = 80\n' >"$S"
  cp "$S" "$BATS_TEST_TMPDIR/original"
  run "$IGLASS" install --terminal warp
  assert_failure_
  assert_output_has "set this in a way iglass doesn't edit: window.override_opacity = 80"
  assert_output_has "Nothing was changed."
  cmp "$S" "$BATS_TEST_TMPDIR/original"
  [[ ! -e "$T" ]] || false
  printf 'appearance = { spacing = "compact" }\n' >"$S"
  run "$IGLASS" install --terminal warp
  assert_failure_
  run "$IGLASS" doctor
  assert_output_has "sets this in a way iglass doesn't edit"
}

@test "warp: a Warp whose schema lacks a setting is refused before anything changes" {
  local schema="$IGLASS_WARP_APP/Contents/Resources/settings_schema.json"
  [[ "$IGLASS_PLATFORM" == linux ]] && schema="$SANDBOX/warp/resources/settings_schema.json"
  jq 'del(.properties.appearance.properties.window.properties.override_opacity)' "$schema" >"$schema.new"
  mv "$schema.new" "$schema"
  run "$IGLASS" install --terminal warp
  assert_failure_
  assert_output_has "This Warp doesn't know these settings: appearance.window.override_opacity"
  [[ ! -e "$S" && ! -e "$T" ]] || false
}

@test "warp: a Warp from before settings.toml gets the files and a note to update" {
  rm -rf "$IGLASS_WARP_APP"
  fake_warp no-schema
  run "$IGLASS" install --terminal warp
  assert_success_
  assert_output_has "may be older than April 2026"
  run "$IGLASS" doctor
  assert_output_has "Couldn't find Warp's settings schema"
}

@test "warp: a read-only settings.toml is left alone, with the lines to add" {
  mkdir -p "$HOME/.warp"
  printf '[appearance.themes]\ntheme = "dark"\n' >"$S"
  chmod 444 "$S"
  run "$IGLASS" install --terminal warp
  assert_success_
  assert_output_has "Couldn't edit $S (read-only?)"
  assert_output_has "override_opacity = 66"
  [[ "$(cat "$S")" == $'[appearance.themes]\ntheme = "dark"' ]] || false
  [[ -f "$T/iglass-dark.yaml" ]] || false
  run "$IGLASS" doctor
  assert_output_has "iglass couldn't change $S"
  chmod 644 "$S"
}

@test "warp: a theme of yours with iglass's file name is moved aside, never overwritten" {
  mkdir -p "$T"
  printf 'name: mine\n' >"$T/iglass-dark.yaml"
  run "$IGLASS" install --terminal warp
  assert_output_has "Moved a Warp theme that wasn't iglass's aside"
  grep -q '^# Generated by iglass' "$T/iglass-dark.yaml"
  grep -rqx 'name: mine' "$IGLASS_STATE_DIR/backups"
}

@test "warp: doctor and status" {
  run "$IGLASS" doctor
  assert_output_has "iglass is not installed for Warp"
  "$IGLASS" install --terminal warp
  run "$IGLASS" doctor
  assert_output_has "Warp reads its settings from settings.toml"
  assert_output_has "iglass's settings are in $S"
  sed -i.bak 's/system_theme = true/system_theme = false/' "$S"
  run "$IGLASS" doctor
  assert_output_has "Changed since iglass set it: system_theme (now: system_theme = false)"
  run "$IGLASS" status
  assert_output_has "Warp"
  assert_output_has "variant frosted · accent blue"
  assert_output_has "settings in $S"
}

@test "warp: Warp is not installed" {
  rm -rf "$IGLASS_WARP_APP" "$SANDBOX/warp"
  export IGLASS_WARP_APP="$SANDBOX/no-warp.app" IGLASS_WARP_BIN="$SANDBOX/no-warp"
  run "$IGLASS" install --terminal warp
  assert_failure_
  assert_output_has "Warp is not installed."
  assert_output_has "https://www.warp.dev/download"
}

@test "warp: found when iglass runs inside it, included in --terminal all, skipped when missing" {
  TERM_PROGRAM=WarpTerminal run "$IGLASS" install
  assert_success_
  assert_output_has "Installed iglass for Warp"
  [[ ! -e "$(profile_file)" ]] || false
  run "$IGLASS" install --terminal all
  assert_output_has "Updated iglass for Warp"
  assert_output_has "kitty isn't installed; skipped."
  rm -rf "$IGLASS_WARP_APP"
  run "$IGLASS" install --terminal all
  assert_output_has "Warp isn't installed; skipped."
  run "$IGLASS" uninstall
  assert_output_has "Removed iglass from Warp"
}

@test "warp: export writes the themes and the settings to copy, and preview explains" {
  run "$IGLASS" export --terminal warp --dir "$SANDBOX/out" --accent green
  assert_success_
  [[ -f "$SANDBOX/out/iglass-dark.yaml" && -f "$SANDBOX/out/iglass-light.yaml" ]] || false
  grep -qx '\[appearance.window\]' "$SANDBOX/out/iglass-settings.toml"
  grep -qx 'override_opacity = 66' "$SANDBOX/out/iglass-settings.toml"
  [[ ! -e "$S" ]] || false # export changes nothing
  run "$IGLASS" export --terminal warp
  assert_failure_
  assert_output_has "pass a folder with --dir"
  run "$IGLASS" preview --terminal warp --variant tinted
  assert_failure_
  assert_output_has "iglass install --terminal warp --variant tinted"
}

@test "warp on Linux: XDG folders, no blur setting, and what each desktop does" {
  use_linux none
  fake_warp
  export XDG_CONFIG_HOME="$SANDBOX/config" XDG_DATA_HOME="$SANDBOX/data" XDG_CURRENT_DESKTOP=KDE
  S="$XDG_CONFIG_HOME/warp-terminal/settings.toml"
  T="$XDG_DATA_HOME/warp-terminal/themes"
  run "$IGLASS" install --terminal warp
  assert_success_
  assert_output_has "KDE Plasma blurs behind apps that ask for it, which Warp doesn't on Linux, so iglass uses Tinted"
  assert_output_has "for Warp (transparency, no blur on this desktop"
  [[ -f "$T/iglass-dark.yaml" ]] || false
  [[ "$(setting appearance.window override_opacity)" == "override_opacity = 82" ]] || false
  [[ -z "$(setting appearance.window override_blur)" ]] || false # a macOS-only Warp setting
  XDG_CURRENT_DESKTOP=Hyprland run "$IGLASS" install --terminal warp
  assert_output_has "Updated iglass for Warp (blur, "
  XDG_CURRENT_DESKTOP=niri MOCK_NIRI=26.04 run "$IGLASS" install --terminal warp
  assert_output_has "niri can still blur it with a window rule"
  assert_output_has 'match app-id="^dev\.warp\.Warp$"'
  XDG_CURRENT_DESKTOP=niri MOCK_NIRI=26.04 run "$IGLASS" doctor
  assert_output_has "niri blurs behind apps that ask for it, which Warp doesn't on Linux"
  "$IGLASS" uninstall --terminal warp
  [[ ! -e "$S" && ! -e "$T" ]] || false
}
